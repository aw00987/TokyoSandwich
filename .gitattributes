# Normalize line endings: store LF in the repo, let Git detect text files.
* text=auto

# Shell scripts must stay LF, even when checked out on Windows.
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# Binary files: never convert.
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.keystore binary
*.jks binary
